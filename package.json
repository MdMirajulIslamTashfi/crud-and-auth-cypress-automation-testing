{
  "name": "crud-auth-e2e",
  "private": true,
  "scripts": {
    "cy:open": "cypress open --browser chrome",
    "test": "cypress run --browser chrome",
    "test:smoke": "cypress run --browser chrome --expose grepTags=@smoke",
    "test:happy": "cypress run --browser chrome --expose grepTags=@happy",
    "test:negative": "cypress run --browser chrome --expose grepTags=@negative",
    "test:manual": "cypress run --headed --browser chrome --expose grepTags=@manual",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cypress/grep": "^7.0.0",
    "@types/node": "^22.0.0",
    "cypress": "16.1.1",
    "typescript": "^5.6.0"
  }
}
